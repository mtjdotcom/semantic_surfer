# pipeline.py – one‑stop function that runs for a single fund
# ------------------------------------------------------------
import logging
from pathlib import Path
from web_scraper import download_report
from pdf_extractor import (
    extract_pdf_text,
    extract_pdf_image,
    extract_excel,
    pull_section,
)

log = logging.getLogger(__name__)

def run_for_fund(fund_key: str, meta: dict) -> Path:
    """
    Downloads the report, extracts the “Private Equity Composite” table,
    writes a CSV named `<fund_key>_pe.csv` and returns the path.
    """
    try:
        pdf_path = download_report(fund_key, meta)

        # Choose extractor based on source_type
        if meta["source_type"] == "excel":
            df_raw = extract_excel(str(pdf_path))
        elif meta["source_type"] == "pdf_text":
            df_raw = extract_pdf_text(str(pdf_path))
        elif meta["source_type"] == "pdf_image":
            df_raw = extract_pdf_image(str(pdf_path))
        else:
            raise ValueError(f"Unsupported source_type: {meta['source_type']}")

        # Pull the PE section (most reports use the same heading)
        df_pe = pull_section(df_raw, heading="Private Equity Composite")

        # Add provenance columns
        df_pe["fund_key"] = fund_key
        df_pe["fund_name"] = meta["name"]
        df_pe["report_date"] = Path(pdf_path).stat().st_mtime  # crude timestamp

        out_path = Path("reports") / f"{fund_key}_pe.csv"
        df_pe.to_csv(out_path, index=False)
        log.info(f"[{fund_key}] extracted {len(df_pe)} rows → {out_path}")
        return out_path
    except Exception as exc:
        log.error(f"[{fund_key}] failed: {exc}")
        raise