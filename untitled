# web_scraper.py – simple downloader + optional link finder
# ------------------------------------------------------------
import os
import requests
from bs4 import BeautifulSoup
from urllib.parse import urljoin
from pathlib import Path

DOWNLOAD_DIR = Path("reports")
DOWNLOAD_DIR.mkdir(exist_ok=True)


def _guess_latest_pdf(url: str) -> str:
    """Very naive “grab the first .pdf link on the page”.  
    Override per‑fund if you need a smarter selector."""
    resp = requests.get(url, timeout=15)
    resp.raise_for_status()
    soup = BeautifulSoup(resp.text, "html.parser")
    for a in soup.find_all("a", href=True):
        if a["href"].lower().endswith(".pdf"):
            return urljoin(url, a["href"])
    raise RuntimeError(f"No PDF found on {url}")


def download_report(fund_key: str, meta: dict) -> Path:
    """
    Returns the local path to the downloaded file.
    If the URL already points to a PDF, we download it directly;
    otherwise we try to guess the PDF link from the landing page.
    """
    dest = DOWNLOAD_DIR / f"{fund_key}.pdf"

    # Already have it?  (skip re‑download unless you force refresh)
    if dest.exists():
        return dest

    target_url = meta["url"]
    if target_url.lower().endswith(".pdf"):
        pdf_url = target_url
    else:
        pdf_url = _guess_latest_pdf(target_url)

    r = requests.get(pdf_url, stream=True, timeout=30)
    r.raise_for_status()
    with open(dest, "wb") as f:
        for chunk in r.iter_content(chunk_size=8192):
            f.write(chunk)

    return dest

