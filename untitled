import pdfplumber
import camelot
import pytesseract
from PIL import Image
import io
import pandas as pd

# ------------------------------------------------------------------
# Helper: clean numeric strings (remove commas, convert to float)
# ------------------------------------------------------------------
def _num(val: str):
    try:
        return float(val.replace(",", "").replace("%", ""))
    except Exception:
        return None


# ------------------------------------------------------------------
# 1️⃣  Structured PDF / Excel (tier 1) – use Camelot or pdfplumber
# ------------------------------------------------------------------
def extract_pdf_text(path: str) -> pd.DataFrame:
    """Try Camelot first (grid mode).  If it fails, fall back to pdfplumber."""
    try:
        tables = camelot.read_pdf(path, pages="all", flavor="stream")
        df = pd.concat([t.df for t in tables], ignore_index=True)
        return df
    except Exception:
        # pdfplumber fallback – grab all text lines and later split on whitespace
        rows = []
        with pdfplumber.open(path) as pdf:
            for page in pdf.pages:
                txt = page.extract_text()
                if txt:
                    rows.extend(txt.splitlines())
        return pd.DataFrame(rows, columns=["raw_line"])


# ------------------------------------------------------------------
# 2️⃣  Image‑only PDF (tier 2) – OCR via pytesseract
# ------------------------------------------------------------------
def extract_pdf_image(path: str) -> pd.DataFrame:
    rows = []
    with pdfplumber.open(path) as pdf:
        for page in pdf.pages:
            im = page.to_image(resolution=300).original
            txt = pytesseract.image_to_string(im)
            rows.extend(txt.splitlines())
    return pd.DataFrame(rows, columns=["raw_line"])


# ------------------------------------------------------------------
# 3️⃣  Excel files (if you ever encounter them)
# ------------------------------------------------------------------
def extract_excel(path: str) -> pd.DataFrame:
    return pd.read_excel(path, sheet_name=None)  # returns dict of sheets


# ------------------------------------------------------------------
# 4️⃣  Generic “hunt for a heading and pull rows below it”
# ------------------------------------------------------------------
def pull_section(df: pd.DataFrame, heading: str) -> pd.DataFrame:
    """
    Works on either a raw‑line DataFrame (one column called 'raw_line')
    or a proper table DataFrame.  Returns a clean table of manager rows.
    """
    if "raw_line" in df.columns:
        # Text‑only mode – split each line into tokens
        lines = df["raw_line"].tolist()
    else:
        # Assume the first column holds the raw concatenated text
        lines = df.iloc[:, 0].astype(str).tolist()

    # Locate the heading (case‑insensitive)
    idx = next((i for i, l in enumerate(lines) if heading.lower() in l.lower()), None)
    if idx is None:
        raise RuntimeError(f"Heading '{heading}' not found")

    # Grab everything until we hit a blank line or a new top‑level heading
    data_lines = []
    for l in lines[idx + 1 :]:
        if not l.strip():               # stop on empty line
            break
        if l.isupper() and len(l.split()) <= 4:  # crude “new section” guard
            break
        data_lines.append(l.strip())

    # Turn the raw strings into a DataFrame by splitting on whitespace
    rows = []
    for line in data_lines:
        parts = line.split()
        # Expect: Name (may be several words) + MarketValue + Allocation% + Perf
        if len(parts) < 4:
            continue
        # The last three tokens are numeric; everything before is the name
        name = " ".join(parts[:-3])
        market, alloc, perf = parts[-3:]
        rows.append(
            {
                "manager": name,
                "market_value": _num(market),
                "allocation_pct": _num(alloc),
                "fytd_perf": perf,
            }
        )
    return pd.DataFrame(rows)

